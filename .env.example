# Copy this file to ".env" and change the values if you need to.
# The Open Library API is free and needs NO API key.

# Port the server listens on
PORT=3000

# Base URL of the API (you normally do not need to change it)
OPENLIBRARY_BASE_URL=https://openlibrary.org

# How long to wait for the API before giving up (milliseconds)
API_TIMEOUT_MS=10000
