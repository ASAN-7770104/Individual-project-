<%- include('partials/header') %>

<section class="result-head">
  <div>
    <p class="eyebrow">Country</p>
    <h1><%= info.commonName %> <span class="code">(<%= info.countryCode %>)</span></h1>
    <p class="muted">
      <%= info.officialName %>
      <% if (info.nativeName && info.nativeName !== info.commonName) { %> &middot; <%= info.nativeName %><% } %>
    </p>
  </div>
  <p class="links">
    <a class="btn" href="/holidays/<%= info.countryCode %>/<%= year %>">All holidays in <%= year %></a>
  </p>
</section>

<section class="card" aria-labelledby="facts-title">
  <h2 id="facts-title">Facts</h2>
  <dl class="facts">
    <div><dt>Region</dt><dd><%= info.region || 'Not available' %></dd></div>
    <div><dt>Country code</dt><dd><%= info.countryCode %></dd></div>
    <div><dt>Neighbours</dt><dd><%= borders.length %></dd></div>
  </dl>

  <h3>Bordering countries</h3>
  <% if (borders.length === 0) { %>
    <p class="muted">This country has no land borders in the data.</p>
  <% } else { %>
    <p class="chips">
      <% borders.forEach((border) => { %>
        <% if (border.supported) { %>
          <a class="chip chip-link" href="/country/<%= border.code %>"><%= border.name %></a>
        <% } else { %>
          <span class="chip" title="Not supported by the holiday service"><%= border.name %></span>
        <% } %>
      <% }) %>
    </p>
  <% } %>
</section>

<section class="card" aria-labelledby="next-title">
  <h2 id="next-title">Upcoming public holidays</h2>
  <% if (upcoming.length === 0) { %>
    <p class="muted">No upcoming holidays were returned for this country.</p>
  <% } else { %>
    <ul class="timeline">
      <% upcoming.forEach((holiday) => { %>
        <li>
          <span class="timeline-date"><%= formatShortDate(holiday.date) %></span>
          <span class="timeline-body">
            <strong><%= holiday.name %></strong>
            <% if (holiday.localName) { %><span class="muted"> &middot; <%= holiday.localName %></span><% } %>
            <br><span class="muted"><%= holiday.weekday %>, <%= relativeDays(holiday.daysFromToday) %></span>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%- include('partials/footer') %>
