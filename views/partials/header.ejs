<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Book Finder</title>
  <meta name="description" content="Search millions of books with the Open Library API: covers, ratings, authors and statistics.">
  <%# Emoji favicon as an inline SVG: no extra file, and the browser no longer asks for /favicon.ico (which was a 404). %>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%93%96%3C/text%3E%3C/svg%3E">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%# Lets keyboard users jump over the navigation straight to the page content. %>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">&#128214;</span> Book Finder</a>
      <nav aria-label="Main navigation">
        <a href="/" class="<%= active === 'home' ? 'active' : '' %>">Search</a>
        <a href="/subjects" class="<%= active === 'subjects' ? 'active' : '' %>">Subjects</a>
        <a href="/about" class="<%= active === 'about' ? 'active' : '' %>">About</a>
      </nav>
    </div>
  </header>
  <main id="main" class="container" tabindex="-1">
